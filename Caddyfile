# ────────────────────────────────────────────────────────────────────────────────
# Caddyfile — Caddy v2 config for ynot-app
# Replace yourdomain.com with your actual domain before deploying.
# Caddy will automatically obtain & renew SSL certificates via Let's Encrypt.
# ────────────────────────────────────────────────────────────────────────────────

yourdomain.com {
    # Enable HTTP/2 Push and compression
    encode zstd gzip

    # Security headers
    header {
        # Enable HSTS
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        # Prevent clickjacking
        X-Frame-Options "SAMEORIGIN"
        # XSS protection
        X-Content-Type-Options "nosniff"
        # Referrer policy
        Referrer-Policy "strict-origin-when-cross-origin"
        # Remove Server header
        -Server
    }

    # Proxy all requests to the Next.js app running internally on port 4001
    reverse_proxy app:4001 {
        # Pass real client IP to Next.js
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}

        # Health check / connection tuning
        transport http {
            dial_timeout 10s
            response_header_timeout 60s
        }
    }

    # Caddy access log
    log {
        output file /var/log/caddy/access.log {
            roll_size 10mb
            roll_keep 5
        }
    }
}

# Optional: redirect www → non-www
# www.yourdomain.com {
#     redir https://yourdomain.com{uri} permanent
# }
